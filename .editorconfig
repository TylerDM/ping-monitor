# EditorConfig -- https://editorconfig.org
# Honoured natively by Visual Studio, RustRover and VS Code (with the
# extension). This is the second half of the cross-platform story:
# .gitattributes controls what Git stores, .editorconfig controls what your
# editor writes.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces is a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

###############################################################################
# Rust
#
# rustfmt is the authority on .rs files; these settings only keep editors from
# fighting it before format-on-save runs. 100 is rustfmt's default max_width.
###############################################################################
[*.rs]
indent_size = 4
max_line_length = 100

# Cargo.toml follows the indentation cargo itself writes.
[*.toml]
indent_size = 4

[*.{json,jsonc,yml,yaml,xml,manifest}]
indent_size = 2

[*.{sh,ps1,psm1,ts}]
indent_size = 2
